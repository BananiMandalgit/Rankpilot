.env
.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/

.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases
*.db
*.sqlite
*.sqlite3
*.db-journal

# IDE / Editors
.vscode/
.idea/
.fleet/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Redis local data
*.rdb
*.aof

# Temporary files
tempCodeRunnerFile.py
*.tmp
*.temp

